{
  "schemaVersion": 1,
  "id": "locatorbar",
  "version": "${version}",
  "name": "LocatorBar: The Ultimate Edition",
  "description": "Reworked concept of a player locator bar for Minecraft. Simple, clean bar at the top of your screen.",
  "authors": [
    "Krylo_plays",
    "FuzjaJadrowa"
  ],
  "contact": {
    "homepage": "https://krishivstudios.github.io",
    "sources": "https://github.com/Krylo-60/LocatorBar-Ultimate",
    "issues": "https://github.com/Krylo-60/LocatorBar-Ultimate/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/locatorbar/textures/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "pl.fuzjajadrowa.locatorbar.fabric.LocatorBarFabric"
    ],
    "client": [
      "pl.fuzjajadrowa.locatorbar.fabric.LocatorBarFabricClient"
    ],
    "modmenu": [
      "pl.fuzjajadrowa.locatorbar.fabric.LocatorBarModMenuIntegration"
    ]
  },
  "mixins": [
    "locatorbar.common.mixins.json",
    "locatorbar.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "*",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}